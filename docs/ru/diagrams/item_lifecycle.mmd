  end

  subgraph P4["4 · MERGE GATE — issue_merge / epic_merge"]
    G0["Gate 0: assert_canon_integrity<br/>sha256-карта манифеста + внешний<br/>штамп + пины adapters_sha256"]
    FRAG["скан .changes фрагментов<br/>bump · issue: ↔ PR · spec_impact<br/>diff-filter включая удаления"]
    VC["verify_constraints.sh<br/>Closes #N · покрытие G/W/T<br/>whitelist контракта · якоря спек"]
    SIG["blood-sign: verify_worktree.sh<br/>detached baseline, без сети<br/>PYTHONPATH/NODE_PATH собираются заново"]
    PN["panel_gate.sh<br/>все этажи зелёные (аттестация gate_run)<br/>+ сигналы ccsdd/&lt;домен&gt; = success<br/>+ свод external_checks"]
    MG{"решение о мерже<br/>expected_sha привязан<br/>risk:high → 2 семейства моделей<br/>+ 👨‍💻 конверт · manual_gate → конверт"}
    G0 --> FRAG --> VC --> SIG --> PN --> MG
  end

  subgraph P5["5 · РЕЛИЗ — только на базовой ветке"]
    RL["repo_release.sh<br/>версия = макс. bump из .changes<br/>CHANGELOG свёрнут, фрагменты удалены"]
    TAG["тег v&lt;X.Y.Z&gt; + GitHub release<br/>строка в release_history.jsonl<br/>cycle_log compact"]
    RPR["защищённая база → release/v* PR<br/>(доказуемый provenance: 1 коммит,<br/>только version-файл + CHANGELOG + .changes)"]
    RL --> TAG
    RL -.->|push запрещён| RPR
  end

