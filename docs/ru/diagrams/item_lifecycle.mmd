  subgraph P2["2 · СПАВН ПУНКТА — сначала контракт"]
    EPB["эпик-ветка<br/>epic_issue_&lt;N&gt;-&lt;slug&gt;"]
    CF["черновик контракта<br/>contract.py/ts · whitelist · риск"]
