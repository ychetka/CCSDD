flowchart TB
  DEV(["👨‍💻 Human — highest arbiter"])

  subgraph P1["1 · PLAN"]
    RM["roadmap.md<br/>items · types · deps · G/W/T · risk flags"]
    AP1{"👨‍💻 roadmap<br/>approve"}
    ISS["issues created<br/>(one per item)"]
    RM --> AP1 --> ISS
  end

  subgraph P2["2 · CONTRACT  (optional batch pass §2a)"]
    CF["contract file<br/>draft"]
    JDG1["⚖️ judge<br/>verdict vs draft"]
    SO["👨‍💻 sign-off envelope<br/>contract sha256 frozen"]
    CF --> JDG1 --> SO
  end

  subgraph P3["3 · IMPLEMENTATION"]
    PRE["pre-consultation<br/>(partners, flags)"]
    SP["spawn executor<br/>context whitelist"]
    INT["pre-code interrogation<br/>assumptions · ambiguities"]
    CODE["code + tests<br/>native run green"]
    JDG2["⚖️ judge<br/>verdict vs frozen contract"]
    PRE --> SP --> INT --> CODE --> JDG2
  end

  subgraph P4["4 · ASSEMBLY → RELEASE"]
    INTG["integration run"]
    RVW{"🔍 reviewer verdict<br/>remote storage only"}
    GIT["🔀 git agent<br/>candidate commit (sha)"]
    MG{"merge gate<br/>isolated copy + expected_sha<br/>+ reviewer APPROVE + green checks<br/>(manual_gate fragment parks for 👨‍💻)"}
    REL["release<br/>version from .changes/"]
    INTG --> RVW -->|APPROVED| GIT --> MG --> REL
  end

  ISS --> CF
  SO --> PRE
  JDG2 -->|changes requested, ≤3 rounds| CODE
  JDG2 -->|accepted| INTG
  JDG2 -.->|">3 rounds"| RES["resolver → stop / escalate"]
  SO -.->|drift| PD["PLAN_DELTA → human"]
  RES -.-> DEV
  PD -.-> DEV
  AP1 -.-> DEV
  SO -.-> DEV
  MG -.->|manual_gate fragment| DEV

  classDef human fill:#f5e6c8,stroke:#8a6d1f,stroke-width:2px
  classDef gate fill:#fde2e2,stroke:#a33,stroke-width:2px
  class DEV,AP1,SO human
  class JDG1,JDG2,RVW,MG gate
