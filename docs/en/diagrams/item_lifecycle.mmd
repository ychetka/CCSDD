flowchart LR
  DEV(["👨‍💻 human — supreme arbiter"])

  subgraph P1["1 · PLAN — arch committee + human"]
    TASK["compound task<br/>set by the human"]
    ARCH["arch committee: ROOT +<br/>architect-partner + product-partner<br/>questions ↔ human"]
    RM["roadmap.md<br/>epics · tasks · G/W/T · risk flags"]
    AP1{"👨‍💻 roadmap<br/>approve"}
    ISS["issues<br/>one per item"]
    TASK --> ARCH --> RM --> AP1 --> ISS
  end

  subgraph P2["2 · EPIC → tasks"]
    EPB["epic branch<br/>epic_issue_&lt;N&gt;-&lt;slug&gt;"]
    DEC["decomposed into tasks<br/>own issue_&lt;M&gt;-&lt;slug&gt; branches"]
    EPB --> DEC
  end

  subgraph P3["3 · TASK → epic branch"]
    CF["contract draft"]
    JDG1["⚖️ judge<br/>draft verdict"]
    SO["👨‍💻 sign-off envelope<br/>contract sha256 frozen"]
    DSG["🎨 designer (conditional)<br/>delegated axes → impl spec"]
    INT["pre-code interrogation<br/>assumptions · ambiguities"]
    CODE["code + tests<br/>green native run"]
    JDG2["⚖️ judge<br/>verdict vs frozen contract"]
    TPR["task PR → epic branch<br/>reviewer bots + CI<br/>NO human · NO version bump"]
    CF --> JDG1 --> SO --> DSG --> INT --> CODE --> JDG2 --> TPR
  end

  subgraph P4["4 · EPIC → default = release"]
    INTG["integration run"]
    GIT["🔀 git agent<br/>candidate commit (sha)<br/>+ push + PR"]
    RVW{"🔍 review panel<br/>domain floors + domain signals<br/>aggregator APPROVE bound to head sha"}
    MG{"merge gate<br/>isolated copy + expected_sha<br/>+ all domain signals + floors + green checks<br/>+ fragment issue: ↔ PR<br/>+ epic: all tasks closed"}
    REL["release: merge to default<br/>version from .changes + tag<br/>(manual_gate waits for 👨‍💻 approve)"]
    INTG --> GIT --> RVW -->|APPROVED| MG --> REL
  end

  ISS --> EPB
  DEC --> CF
  TPR -->|all tasks merged| INTG
  JDG2 -->|changes, ≤3 rounds| CODE
  JDG2 -.->|">3 rounds"| RES["resolver → stop / escalation"]
  SO -.->|drift| PD["PLAN_DELTA → human"]
  DEV -.-> TASK
  AP1 -.-> DEV
  SO -.-> DEV
  MG -.->|manual_gate fragment| DEV
  RES -.-> DEV
  PD -.-> DEV

  classDef human fill:#f5e6c8,stroke:#8a6d1f,stroke-width:2px
  classDef gate fill:#fde2e2,stroke:#a33,stroke-width:2px
  class DEV,AP1,SO human
  class JDG1,JDG2,RVW,MG gate
