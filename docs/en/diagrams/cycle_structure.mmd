flowchart LR
  subgraph COM1["ARCHITECTURE COMMITTEE"]
    ROOT["🧭 ROOT director<br/>plan · contracts · spawns"]
    AP[["🏛️ architect-partner<br/>co-designer · top-tier"]]
    PPA[["📦 product-partner<br/>co-designer · top-tier"]]
    DEV(["👨‍💻 human<br/>arbiter · signs via<br/>ssh-agent key OFF workspace"])
  end
  subgraph COM2["EXECUTIVE COMMITTEE"]
    CW["👷 CW executor<br/>code + tests in scope whitelist<br/>ship_commit only"]
    DSG["🎨 DSG designer (conditional)<br/>delegated axes → impl spec"]
    DP[["🧩 design-partner<br/>consultant · workhorse"]]
    PPE[["📦 product-partner<br/>consultant · workhorse"]]
  end
  subgraph REV["REVIEWERS — outside both committees"]
    JDG["⚖️ JDG judge<br/>frozen contract only"]
    RVW["🔍 RVW review panel<br/>domain floors (gate_run attested)<br/>+ ccsdd/&lt;domain&gt; signals<br/>aggregator posts PR review"]
    RES["🤝 RES resolver"]
    RD["📖 RD reader<br/>sha attestation"]
  end
  subgraph REPOS["REPO AGENTS"]
    GIT["🔀 GIT commit agent<br/>ship_commit/push (Gate 0 +<br/>scope + hygiene + secrets)"]
    RA["🏁 RA merge/release<br/>issue/epic/repo_merge · repo_release<br/>Gate 0 → fragments → constraints<br/>→ blood-sign → panel → decision"]
    HYG["🧹 HYG hygiene gate"]
  end

  ART[/"📦 artifacts:<br/>roadmap · contract(sha) · .changes<br/>journals: cycle_log · gate_runs ·<br/>release_history · actors.json"/]
  ENV[/"🔐 envelopes:<br/>human_signoffs/ · .used_nonces ·<br/>.superseded_contracts<br/>ssh-sig · artifact-bound"/]
  REPO[("🗄️ storage<br/>repo + CI + PR")]
  GW[["🛰️ gateway<br/>partner_call → gw_store<br/>quota + inflight reaper + journal<br/>gateway.db"]]
  XA[["🏛️ ex-architect-partner<br/>Audit · dispute arbitration"]]
  RULES[["📜 canon/<br/>RULES.md · agents · specs ·<br/>policy.json · manifest-pinned<br/>(Gate 0 verifies before use)"]]

  ROOT -->|spawn: package| CW
  ROOT -->|spawn: axes| DSG
  ROOT -->|contract draft| JDG
  DSG -->|impl spec| CW
  CW -->|report/blocker| ROOT
  CW --> ART
  JDG -->|accepted/resolver/escalation| ROOT
  RVW -->|approve/changes — direct| REPO
  RES -->|verdict| ROOT
  GIT -->|candidate sha| REPO
  RA -->|merge gate| REPO
  GIT -.-> HYG
  RA -.-> HYG
  ART -.-> ENV
  ROOT <-.-> ART
  GW -.-> AP
  GW -.-> PPA
  GW -.-> DP
  GW -.-> PPE
  GW -.-> XA
  XA -.->|arbitration| ROOT
  AP -.->|consult| ROOT
  PPA -.->|consult| ROOT
  DP -.->|consult| CW
  PPE -.->|consult| CW
  RULES -.-> ROOT
  RULES -.-> CW
  RULES -.-> RA
  DEV -.->|"👨‍💻 roadmap · sign-off ·<br/>manual_gate · escalations<br/>(envelope, never text)"| ROOT

  classDef human fill:#f5e6c8,stroke:#8a6d1f,stroke-width:2px
  classDef rev fill:#e8e0f5,stroke:#5b4a8a,stroke-width:2px
  classDef partner stroke-dasharray:5 5
  classDef store fill:#eef7ee,stroke:#3a7a3a,stroke-width:1.5px
  class DEV human
  class JDG,RVW,RES,RD rev
  class AP,PPA,DP,PPE,XA partner
  class ART,ENV,REPO store
